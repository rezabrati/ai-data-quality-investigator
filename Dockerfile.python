FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    DATA_STORAGE_DIR="/app/data/datasets"

COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/

RUN uv sync --locked --no-dev --no-editable

EXPOSE 8000 8001

CMD ["python", "-m", "uvicorn", "ai_data_quality_investigator.api.main:app", "--host", "0.0.0.0", "--port", "8000"]