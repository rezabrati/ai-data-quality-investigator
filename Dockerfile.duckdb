FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir "mcp-server-motherduck==1.1.1"

EXPOSE 8000

CMD ["mcp-server-motherduck", "--transport", "http", "--host", "0.0.0.0", "--port", "8000", "--db-path", ":memory:", "--read-write", "--max-rows", "100", "--max-chars", "12000", "--query-timeout", "15"]